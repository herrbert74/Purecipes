		android:interpolator="@android:interpolator/linear"
		android:propertyName="translateX"
		android:repeatCount="-1"
		android:valueType="floatType">
		<propertyValuesHolder android:propertyName="translateX">
			<keyframe android:fraction="0" android:value="299" />
			<keyframe android:fraction="0.25" android:value="281" />
			<keyframe android:fraction="0.5" android:value="263" />
			<keyframe android:fraction="0.75" android:value="281" />

<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:aapt="http://schemas.android.com/aapt"
	android:drawable="@drawable/ic_launcher_splash_vector">

	<target android:name="spoonStir">
		<aapt:attr name="android:animation">
			<set android:ordering="together">
				<objectAnimator
					android:duration="1500"
					android:interpolator="@android:interpolator/linear"
					android:propertyName="translateX"
					android:repeatCount="infinite"
					android:repeatMode="restart"
					android:valueType="floatType">
					<propertyValuesHolder android:propertyName="translateX">
						<keyframe android:fraction="0" android:value="18" />
						<keyframe android:fraction="0.25" android:value="0" />
						<keyframe android:fraction="0.5" android:value="-18" />
						<keyframe android:fraction="0.75" android:value="0" />
						<keyframe android:fraction="1" android:value="18" />
					</propertyValuesHolder>
				</objectAnimator>
				<objectAnimator
					android:duration="1500"
					android:interpolator="@android:interpolator/linear"
					android:propertyName="translateY"
					android:repeatCount="infinite"
					android:repeatMode="restart"
					android:valueType="floatType">
					<propertyValuesHolder android:propertyName="translateY">
						<keyframe android:fraction="0" android:value="0" />
						<keyframe android:fraction="0.25" android:value="15" />
						<keyframe android:fraction="0.5" android:value="0" />
						<keyframe android:fraction="0.75" android:value="-15" />
						<keyframe android:fraction="1" android:value="0" />
					</propertyValuesHolder>
				</objectAnimator>
			</set>
		</aapt:attr>
	</target>

	<target android:name="handStir">
		<aapt:attr name="android:animation">
			<set android:ordering="together">
				<objectAnimator
					android:duration="1500"
					android:interpolator="@android:interpolator/linear"
					android:propertyName="translateX"
					android:repeatCount="infinite"
					android:repeatMode="restart"
					android:valueType="floatType">
					<propertyValuesHolder android:propertyName="translateX">
						<keyframe android:fraction="0" android:value="299" />
						<keyframe android:fraction="0.25" android:value="281" />
						<keyframe android:fraction="0.5" android:value="263" />
						<keyframe android:fraction="0.75" android:value="281" />
						<keyframe android:fraction="1" android:value="299" />
					</propertyValuesHolder>
				</objectAnimator>
				<objectAnimator
					android:duration="1500"
					android:interpolator="@android:interpolator/linear"
					android:propertyName="translateY"
					android:repeatCount="infinite"
					android:repeatMode="restart"
					android:valueType="floatType">
					<propertyValuesHolder android:propertyName="translateY">
						<keyframe android:fraction="0" android:value="131.4" />
						<keyframe android:fraction="0.25" android:value="146.4" />
						<keyframe android:fraction="0.5" android:value="131.4" />
						<keyframe android:fraction="0.75" android:value="116.4" />
						<keyframe android:fraction="1" android:value="131.4" />
					</propertyValuesHolder>
				</objectAnimator>
			</set>
		</aapt:attr>
	</target>
</animated-vector>

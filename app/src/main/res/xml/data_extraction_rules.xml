<?xml version="1.0" encoding="utf-8"?>
<!--
   Excludes the dedicated auth session SharedPreferences file from cloud backup and
   device transfer. See AUTH_SESSION_PREFERENCES_NAME in shared/data AuthSessionSettings.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude
			domain="sharedpref"
			path="purecipes_auth_session.xml" />
	</cloud-backup>
	<device-transfer>
		<exclude
			domain="sharedpref"
			path="purecipes_auth_session.xml" />
	</device-transfer>
</data-extraction-rules>

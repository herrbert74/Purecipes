<?xml version="1.0" encoding="utf-8"?>
<!--
   Excludes the dedicated auth session SharedPreferences file from Auto Backup.
   See AUTH_SESSION_PREFERENCES_NAME in shared/data AuthSessionSettings.
   Note: This file is ignored for devices older than API 31.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
	<exclude
		domain="sharedpref"
		path="purecipes_auth_session.xml" />
</full-backup-content>

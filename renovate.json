{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays"
  ],
  "ignoreDeps": [
    "org.hamcrest:hamcrest",
    "org.hamcrest:hamcrest-core",
    "firebase/firebase-ios-sdk"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "allowedVersions": "!/(SNAPSHOT|\\+dev)/"
    },
    {
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
      "allowedVersions": "!/-[0-9]+\\.x-compat$/"
    },
    {
      "groupName": "All Minor & Patch Updates",
      "groupSlug": "all-minor-patch",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackagePatterns": ["*"],
      "labels": ["renovate"]
    },
    {
      "description": "iOS Firebase SwiftPM version follows kmpnotifier-push-firebase; bump via firebaseIosSdk in libs.versions.toml when kmpnotifier updates",
      "matchManagers": ["swift"],
      "matchPackageNames": [
        "firebase/firebase-ios-sdk",
        "firebase-ios-sdk",
        "https://github.com/firebase/firebase-ios-sdk.git"
      ],
      "enabled": false
    }
  ]
}

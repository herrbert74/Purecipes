{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays"
  ],
  "ignoreDeps": [
    "org.hamcrest:hamcrest",
    "org.hamcrest:hamcrest-core",
    "firebase/firebase-ios-sdk",
    "dev.gitlive:firebase-auth",
    "dev.gitlive:firebase-app"
  ],
  "packageRules": [
    {
      "allowedVersions": "!/(SNAPSHOT|\\+dev|\\+snapshot)/i",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "Java is pinned to JDK 25 LTS; bump manually on the next LTS",
      "matchDatasources": ["java-version"],
      "matchPackageNames": ["java", "java-jdk", "java-jre"],
      "enabled": false
    },
    {
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
      "allowedVersions": "!/\\.x-compat$/"
    },
    {
      "groupName": "All Minor & Patch Updates",
      "groupSlug": "all-minor-patch",
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["renovate"],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "iOS Firebase SwiftPM version follows kmpnotifier-push-firebase; bump via firebaseIosSdk in libs.versions.toml when kmpnotifier updates",
      "matchManagers": ["swift"],
      "matchPackageNames": [
        "firebase/firebase-ios-sdk",
        "firebase-ios-sdk",
        "https://github.com/firebase/firebase-ios-sdk.git"
      ],
      "enabled": false
    },
    {
      "description": "Generated Kotlin SwiftPM import packages; Gradle regenerates these from kmpauth/kmpnotifier metadata",
      "matchManagers": ["swift"],
      "matchFileNames": [
        ".swiftpm-locks/**",
        "iosApp/PurecipesIOSApp/KotlinMultiplatformLinkedPackage/**"
      ],
      "enabled": false
    }
  ]
}
